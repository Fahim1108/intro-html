# Copy this file to .env and replace every value.
PORT=3001
NODE_ENV=development

# Set this to the public origin in production, e.g. https://needyoursite.com
APP_ORIGIN=

# Used only when no admin account exists. Choose a strong, unique password.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Keep this off when the app is directly exposed; enable it behind one trusted proxy.
TRUST_PROXY=0

# Optional paths (defaults shown)
# DATABASE_PATH=data/needyoursite.db
# UPLOAD_DIR=uploads/projects
